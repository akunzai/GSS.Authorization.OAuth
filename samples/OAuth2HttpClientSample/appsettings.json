{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  // Points at the oauth2 service in compose.yml, which accepts any client and
  // validates the bearer token on its userinfo endpoint.
  "OAuth2": {
    "AccessTokenEndpoint": "http://oauth2:8080/default/token",
    "ResourceEndpoint": "http://oauth2:8080/default/userinfo",
    "ClientId": "demo-client",
    "ClientSecret": "demo-secret",
    // ClientCredentials | ResourceOwnerCredentials
    "GrantFlow": "ClientCredentials"
  }
}
